{
  "version": "1.0.0-review",
  "validation_rules": [
    {
      "validation_id": "GES-P02-VAL-000001",
      "object": "API Request",
      "field_or_process": "tenant_id",
      "rule": "Required for governed endpoints and must match authenticated context.",
      "severity": "Error",
      "error_message": "Tenant context is missing or invalid.",
      "when_applied": "Request",
      "owner": "API Governance",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P02-VAL-000002",
      "object": "API Request",
      "field_or_process": "idempotency_key",
      "rule": "Required for retryable create and command endpoints; max 128 characters.",
      "severity": "Error",
      "error_message": "Provide a valid idempotency key.",
      "when_applied": "Request",
      "owner": "API Governance",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P02-VAL-000003",
      "object": "Event",
      "field_or_process": "event_id",
      "rule": "Required UUID/ULID and unique per producer.",
      "severity": "Error",
      "error_message": "Event ID is missing or duplicated.",
      "when_applied": "Publish",
      "owner": "Integration Architecture",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P02-VAL-000004",
      "object": "Event",
      "field_or_process": "schema_version",
      "rule": "Required and supported by publisher contract.",
      "severity": "Error",
      "error_message": "Unsupported event schema version.",
      "when_applied": "Publish/Consume",
      "owner": "Integration Architecture",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P02-VAL-000005",
      "object": "File",
      "field_or_process": "checksum",
      "rule": "Required SHA-256 for accepted content.",
      "severity": "Error",
      "error_message": "File checksum is missing or invalid.",
      "when_applied": "Upload finalize",
      "owner": "Records Platform",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P02-VAL-000006",
      "object": "File",
      "field_or_process": "classification",
      "rule": "Required and permitted for tenant and uploader.",
      "severity": "Error",
      "error_message": "Select an authorized classification.",
      "when_applied": "Upload/Change",
      "owner": "Records Platform",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P02-VAL-000007",
      "object": "Schedule",
      "field_or_process": "rrule_or_datetime",
      "rule": "Must parse, include timezone context, and not exceed policy frequency.",
      "severity": "Error",
      "error_message": "Enter a valid permitted schedule.",
      "when_applied": "Create/Update",
      "owner": "Scheduler Platform",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P02-VAL-000008",
      "object": "Background Job",
      "field_or_process": "max_attempts",
      "rule": "Integer between 1 and tenant policy maximum.",
      "severity": "Error",
      "error_message": "Enter an allowed retry count.",
      "when_applied": "Create",
      "owner": "Job Platform",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P02-VAL-000009",
      "object": "Webhook Subscription",
      "field_or_process": "endpoint_url",
      "rule": "HTTPS required outside approved development; address must pass SSRF protection.",
      "severity": "Error",
      "error_message": "Enter a secure permitted endpoint.",
      "when_applied": "Create/Update",
      "owner": "Integration Security",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P02-VAL-000010",
      "object": "Webhook Event",
      "field_or_process": "signature",
      "rule": "Required and computed using active subscription secret/version.",
      "severity": "Error",
      "error_message": "Webhook signature is invalid.",
      "when_applied": "Deliver/Verify",
      "owner": "Integration Security",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P02-VAL-000011",
      "object": "Offline Pack",
      "field_or_process": "expires_at",
      "rule": "Required and within mobile security policy.",
      "severity": "Error",
      "error_message": "Choose an allowed offline expiration.",
      "when_applied": "Create",
      "owner": "Mobile Security",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P02-VAL-000012",
      "object": "Sync Transaction",
      "field_or_process": "base_version",
      "rule": "Required for update and delete operations.",
      "severity": "Error",
      "error_message": "Base record version is required.",
      "when_applied": "Queue/Apply",
      "owner": "Mobile Platform",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P02-VAL-000013",
      "object": "Quantity",
      "field_or_process": "unit_code",
      "rule": "Must exist in active unit registry and be compatible with dimension.",
      "severity": "Error",
      "error_message": "Select a valid compatible unit.",
      "when_applied": "Create/Calculate",
      "owner": "Data Architecture",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P02-VAL-000014",
      "object": "Money",
      "field_or_process": "currency_code",
      "rule": "Valid active ISO currency code required.",
      "severity": "Error",
      "error_message": "Enter a supported currency.",
      "when_applied": "Create/Calculate",
      "owner": "Finance Platform",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P02-VAL-000015",
      "object": "AI Request",
      "field_or_process": "agent_version",
      "rule": "Required and active in agent registry.",
      "severity": "Error",
      "error_message": "Select an approved active agent version.",
      "when_applied": "Execute",
      "owner": "AI Platform",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P02-VAL-000016",
      "object": "AI Tool Call",
      "field_or_process": "permission_decision_id",
      "rule": "Required before protected tool execution.",
      "severity": "Error",
      "error_message": "AI tool authorization is missing.",
      "when_applied": "Execute",
      "owner": "AI Platform",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P02-VAL-000017",
      "object": "Configuration",
      "field_or_process": "value",
      "rule": "Must match declared type, range, enum, and scope override policy.",
      "severity": "Error",
      "error_message": "Configuration value is invalid.",
      "when_applied": "Create/Activate",
      "owner": "Platform Configuration",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P02-VAL-000018",
      "object": "Feature Flag",
      "field_or_process": "allocation_percent",
      "rule": "Number from 0 through 100.",
      "severity": "Error",
      "error_message": "Allocation must be between 0 and 100.",
      "when_applied": "Create/Update",
      "owner": "Release Management",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P02-VAL-000019",
      "object": "Secret",
      "field_or_process": "rotation_due_at",
      "rule": "Required for rotatable credentials and within maximum age policy.",
      "severity": "Error",
      "error_message": "Set a compliant rotation due date.",
      "when_applied": "Create/Rotate",
      "owner": "Security Engineering",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P02-VAL-000020",
      "object": "Backup",
      "field_or_process": "restore_test_status",
      "rule": "Production backup set requires successful or scheduled restore verification.",
      "severity": "Warning",
      "error_message": "Backup restore verification is incomplete.",
      "when_applied": "Review",
      "owner": "Resilience Engineering",
      "status": "Review",
      "version": "1.0.0-review"
    }
  ]
}