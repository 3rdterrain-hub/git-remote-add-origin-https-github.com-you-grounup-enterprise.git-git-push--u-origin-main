{
  "version": "1.0.0-review",
  "validation_rules": [
    {
      "validation_id": "GES-P01-VAL-000001",
      "object": "Tenant",
      "field_or_process": "tenant_key",
      "rule": "Required, unique, lowercase slug; 3-50 characters.",
      "severity": "Error",
      "error_message": "Enter a unique tenant key.",
      "when_applied": "Create/Update",
      "owner": "Platform Administration",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P01-VAL-000002",
      "object": "Organization Unit",
      "field_or_process": "parent_unit_id",
      "rule": "Parent must belong to the same tenant and cannot create a hierarchy cycle.",
      "severity": "Error",
      "error_message": "Select a valid parent in the same tenant.",
      "when_applied": "Create/Move",
      "owner": "Platform Administration",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P01-VAL-000003",
      "object": "User",
      "field_or_process": "email",
      "rule": "Required and normalized; uniqueness is evaluated by identity-provider policy.",
      "severity": "Error",
      "error_message": "Enter a valid authorized email address.",
      "when_applied": "Invite/Update",
      "owner": "Identity Administration",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P01-VAL-000004",
      "object": "Role",
      "field_or_process": "role_key",
      "rule": "Required and unique within tenant; system role keys are reserved.",
      "severity": "Error",
      "error_message": "Enter a unique non-reserved role key.",
      "when_applied": "Create/Update",
      "owner": "Security Governance",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P01-VAL-000005",
      "object": "Permission Grant",
      "field_or_process": "scope_id",
      "rule": "Scope type and identifier must match and belong to the grant tenant.",
      "severity": "Error",
      "error_message": "Select a valid authorized scope.",
      "when_applied": "Create/Update",
      "owner": "Security Governance",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P01-VAL-000006",
      "object": "Delegation",
      "field_or_process": "effective_to",
      "rule": "Must be after effective_from and within policy maximum duration.",
      "severity": "Error",
      "error_message": "Enter a valid delegation period.",
      "when_applied": "Create/Update",
      "owner": "Workflow Governance",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P01-VAL-000007",
      "object": "Policy Version",
      "field_or_process": "effective_from/effective_to",
      "rule": "Active periods cannot overlap for the same policy and scope.",
      "severity": "Error",
      "error_message": "Resolve the overlapping policy period.",
      "when_applied": "Activate",
      "owner": "Compliance Governance",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P01-VAL-000008",
      "object": "Approval Request",
      "field_or_process": "approver_id",
      "rule": "Approver must satisfy role, scope, amount, independence, and active-user requirements.",
      "severity": "Error",
      "error_message": "Select an eligible independent approver.",
      "when_applied": "Assign/Decide",
      "owner": "Workflow Governance",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P01-VAL-000009",
      "object": "Retention Schedule",
      "field_or_process": "duration",
      "rule": "Duration and trigger must be specified for each governed record class.",
      "severity": "Error",
      "error_message": "Define trigger and retention duration.",
      "when_applied": "Create/Activate",
      "owner": "Records Governance",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P01-VAL-000010",
      "object": "Legal Hold",
      "field_or_process": "matter_reference",
      "rule": "Required; release requires authorized decision and release date.",
      "severity": "Error",
      "error_message": "Enter the legal matter reference.",
      "when_applied": "Create/Release",
      "owner": "Records Governance",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P01-VAL-000011",
      "object": "Configuration Value",
      "field_or_process": "value",
      "rule": "Must match declared data type, allowed values, range, and layer authorization.",
      "severity": "Error",
      "error_message": "Enter a valid permitted configuration value.",
      "when_applied": "Create/Update",
      "owner": "Platform Administration",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P01-VAL-000012",
      "object": "Emergency Access",
      "field_or_process": "justification",
      "rule": "Required, minimum 20 characters, with approver and expiration.",
      "severity": "Error",
      "error_message": "Provide sufficient justification, approval, and expiration.",
      "when_applied": "Request/Approve",
      "owner": "Security Governance",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P01-VAL-000013",
      "object": "AI Action Proposal",
      "field_or_process": "evidence",
      "rule": "Material proposals require source evidence, agent version, confidence, and target diff.",
      "severity": "Error",
      "error_message": "Add the required AI evidence and proposed change.",
      "when_applied": "Submit",
      "owner": "AI Governance",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P01-VAL-000014",
      "object": "Change Request",
      "field_or_process": "impact_analysis",
      "rule": "Locked-object changes require affected records, risks, migration, rollback, and tests.",
      "severity": "Error",
      "error_message": "Complete the required impact analysis.",
      "when_applied": "Submit/Approve",
      "owner": "Change Control Board",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P01-VAL-000015",
      "object": "Audit Event",
      "field_or_process": "occurred_at",
      "rule": "Must be immutable, UTC, and accompanied by actor/action/object/correlation identifiers.",
      "severity": "Error",
      "error_message": "Audit event payload is incomplete.",
      "when_applied": "Ingest",
      "owner": "Audit Governance",
      "status": "Review",
      "version": "1.0.0-review"
    }
  ]
}