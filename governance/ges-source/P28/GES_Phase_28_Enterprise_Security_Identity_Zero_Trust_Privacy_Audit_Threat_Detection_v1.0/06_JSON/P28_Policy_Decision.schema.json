{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GrounUp Security Policy Decision",
  "type": "object",
  "required": [
    "decision_id",
    "tenant_id",
    "actor_id",
    "action",
    "resource_type",
    "allowed",
    "policy_ids",
    "decided_at",
    "correlation_id"
  ],
  "properties": {
    "decision_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "resource_type": {
      "type": "string"
    },
    "resource_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "allowed": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    },
    "policy_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attributes": {
      "type": "object"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string"
    },
    "source_requirement_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}