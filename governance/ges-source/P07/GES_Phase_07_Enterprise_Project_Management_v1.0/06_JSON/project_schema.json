{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GrounUp Project",
  "type": "object",
  "required": [
    "tenant_id",
    "company_id",
    "project_id",
    "name",
    "status",
    "timezone",
    "currency_code"
  ],
  "properties": {
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "company_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "currency_code": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "custom_fields": {
      "type": "object"
    }
  }
}