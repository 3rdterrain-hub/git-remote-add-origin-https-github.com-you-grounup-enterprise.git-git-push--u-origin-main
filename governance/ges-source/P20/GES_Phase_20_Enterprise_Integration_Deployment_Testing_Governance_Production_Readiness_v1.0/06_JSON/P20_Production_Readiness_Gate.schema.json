{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GrounUp Production Readiness Gate",
  "type": "object",
  "required": [
    "tenant_id",
    "environment_id",
    "record_id",
    "readiness_status",
    "created_at"
  ],
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "environment_id": {
      "type": "string"
    },
    "record_id": {
      "type": "string"
    },
    "release_version": {
      "type": "string"
    },
    "readiness_status": {
      "type": "string"
    },
    "coverage_status": {
      "type": "string"
    },
    "rollback_status": {
      "type": "string"
    },
    "evidence_uri": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}