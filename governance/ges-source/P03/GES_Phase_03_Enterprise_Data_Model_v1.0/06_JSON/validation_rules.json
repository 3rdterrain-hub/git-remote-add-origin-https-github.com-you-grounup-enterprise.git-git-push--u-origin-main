{
  "validation_rules": [
    {
      "validation_id": "GES-P03-VAL-000001",
      "object": "All Tenant Entities",
      "field_or_process": "tenant_id",
      "rule": "Required and must equal the authenticated tenant context.",
      "severity": "Error",
      "error_message": "Tenant context mismatch.",
      "when_applied": "Create/Update",
      "owner": "Enterprise Data Architecture",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P03-VAL-000002",
      "object": "All Entities",
      "field_or_process": "id",
      "rule": "Required immutable UUID/ULID.",
      "severity": "Error",
      "error_message": "A valid immutable identifier is required.",
      "when_applied": "Create/Update",
      "owner": "Enterprise Data Architecture",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P03-VAL-000003",
      "object": "All Mutable Entities",
      "field_or_process": "version",
      "rule": "Positive integer and must equal current persisted version on update.",
      "severity": "Error",
      "error_message": "The record has changed; refresh and retry.",
      "when_applied": "Update",
      "owner": "Enterprise Data Architecture",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P03-VAL-000004",
      "object": "Effective-Dated Entity",
      "field_or_process": "effective_start/effective_end",
      "rule": "Start required; end must be later than start.",
      "severity": "Error",
      "error_message": "Enter a valid effective period.",
      "when_applied": "Create/Update",
      "owner": "Data Governance",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P03-VAL-000005",
      "object": "Money",
      "field_or_process": "currency_code",
      "rule": "Required active ISO currency code.",
      "severity": "Error",
      "error_message": "Select a supported currency.",
      "when_applied": "Create/Calculate",
      "owner": "Finance Data",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P03-VAL-000006",
      "object": "Quantity",
      "field_or_process": "unit_code",
      "rule": "Required and compatible with declared dimension.",
      "severity": "Error",
      "error_message": "Select a compatible unit.",
      "when_applied": "Create/Calculate",
      "owner": "Enterprise Data Architecture",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P03-VAL-000007",
      "object": "ExternalIdentifier",
      "field_or_process": "source_system_id + external_id",
      "rule": "Unique within tenant, source system, entity type, and active status.",
      "severity": "Error",
      "error_message": "This external identifier is already assigned.",
      "when_applied": "Create/Update",
      "owner": "Integration Data",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P03-VAL-000008",
      "object": "DocumentVersion",
      "field_or_process": "checksum",
      "rule": "Required SHA-256 and must match stored bytes.",
      "severity": "Error",
      "error_message": "Document checksum does not match.",
      "when_applied": "Accept",
      "owner": "Records Governance",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P03-VAL-000009",
      "object": "EstimateVersion",
      "field_or_process": "status",
      "rule": "Released version cannot return to draft.",
      "severity": "Error",
      "error_message": "Create a new estimate version.",
      "when_applied": "Transition",
      "owner": "Estimating Data",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P03-VAL-000010",
      "object": "AIWriteback",
      "field_or_process": "approval_status",
      "rule": "Material change requires approved status before commit.",
      "severity": "Error",
      "error_message": "Required approval is incomplete.",
      "when_applied": "Commit",
      "owner": "AI Governance",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P03-VAL-000011",
      "object": "Spatial Entity",
      "field_or_process": "spatial_reference_id",
      "rule": "Required whenever geometry is present.",
      "severity": "Error",
      "error_message": "A coordinate reference system is required.",
      "when_applied": "Create/Update",
      "owner": "Spatial Data",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P03-VAL-000012",
      "object": "StationRange",
      "field_or_process": "start_station/end_station",
      "rule": "End must be greater than or equal to start and unit required.",
      "severity": "Error",
      "error_message": "Enter a valid station range.",
      "when_applied": "Create/Update",
      "owner": "Spatial Data",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P03-VAL-000013",
      "object": "Qualification",
      "field_or_process": "issued_at/expires_at",
      "rule": "Expiration cannot precede issue date.",
      "severity": "Error",
      "error_message": "Qualification dates are invalid.",
      "when_applied": "Create/Update",
      "owner": "Safety Data",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P03-VAL-000014",
      "object": "PartyRelationship",
      "field_or_process": "from_party/to_party/type",
      "rule": "Parties must differ unless the relationship type explicitly permits self-reference.",
      "severity": "Error",
      "error_message": "Select two valid parties.",
      "when_applied": "Create/Update",
      "owner": "Master Data",
      "status": "Review",
      "version": "1.0.0-review"
    },
    {
      "validation_id": "GES-P03-VAL-000015",
      "object": "ReferenceValue",
      "field_or_process": "code",
      "rule": "Unique within active reference set and effective period.",
      "severity": "Error",
      "error_message": "Reference code already exists.",
      "when_applied": "Create/Activate",
      "owner": "Reference Data",
      "status": "Review",
      "version": "1.0.0-review"
    }
  ]
}