{
  "openapi": "3.1.0",
  "info": {
    "title": "GrounUp Enterprise API",
    "version": "1.0.0",
    "description": "The GrounUp Enterprise public API.\n\nAuthenticate with an API key as `Authorization: Bearer gu_live_…`. A key is shown once\nat creation and only its SHA-256 hash is stored, so it cannot be recovered — if a key is\nlost, revoke it and issue another.\n\nEvery key belongs to exactly one company. Scopes decide what kind of record a key may\nread or write; the company decides which records exist. No scope widens the second, so a\nkey can never reach another company’s data regardless of the scopes it holds.\n\nErrors share one shape. Handle `error.code`, which is stable, rather than `error.message`,\nwhich is written for people.",
    "contact": {
      "name": "GrounUp Enterprise",
      "url": "https://grounup.example/docs/api"
    }
  },
  "servers": [
    {
      "url": "https://{project}.supabase.co/functions/v1/api",
      "variables": {
        "project": {
          "default": "your-project"
        }
      }
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "estimates"
    },
    {
      "name": "finance"
    },
    {
      "name": "fleet"
    },
    {
      "name": "metrics"
    },
    {
      "name": "projects"
    },
    {
      "name": "workforce"
    }
  ],
  "paths": {
    "/projects": {
      "get": {
        "summary": "List projects.",
        "operationId": "getProjects",
        "tags": [
          "projects"
        ],
        "security": [
          {
            "apiKey": [
              "projects:read"
            ]
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            },
            "description": "Page size. A larger value is clamped to 200 and reported in `warnings`."
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "The key is missing, unrecognized, revoked or expired. These are deliberately indistinguishable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The key does not hold the `projects:read` scope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such endpoint, or no such record inside the calling company.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "The key exceeded its per-minute rate limit. See `Retry-After`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "The request could not be completed. No internal detail is returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
