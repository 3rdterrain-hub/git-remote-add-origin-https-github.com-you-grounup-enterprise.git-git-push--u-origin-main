# ---------------------------------------------------------------------------
# Frontend (apps/web/.env.local) — PUBLIC. Everything here ships in the bundle.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Which social sign-in buttons the login page offers. Comma separated, from
# google, apple, azure, github. Leave it unset and the page offers a password
# and a one-time email link, which need no provider set up.
#
# A provider named here must already be enabled in the Supabase project's Auth
# settings with its client id and secret. Naming one that is not gives a button
# that leads to an error page instead of a sign-in, which is why it is opt-in
# rather than on by default.
# VITE_OAUTH_PROVIDERS=google,apple

# ---------------------------------------------------------------------------
# Edge Function secrets — SERVER SIDE ONLY.
# Set with: supabase secrets set KEY=value
# Never prefix any of these with VITE_; that would publish them to every visitor.
# ---------------------------------------------------------------------------
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the Supabase platform and do not need to be set by hand.

# Stripe. The secret key must start with sk_, never pk_.
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the webhook endpoint in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...

# Absolute base URL the checkout and portal return to.
APP_URL=https://app.yourdomain.com

# Comma-separated origins permitted to call the functions from a browser.
# Do not use "*": these endpoints act on an authenticated session and start payments.
ALLOWED_ORIGINS=https://app.yourdomain.com,http://localhost:5173
